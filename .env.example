# OpenAI API key — used by /api/generate-{single,carousel,print,email}-image
# to render visuals via gpt-image-2 (ChatGPT Images 2.0). Mint at
# https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional override for the image model. Default: gpt-image-2.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional override for image output size. Default: 1024x1024. gpt-image-2
# supports 1024x1024, 1536x1024, 1024x1536, 2048x2048, etc.
OPENAI_IMAGE_SIZE=1024x1024

# Concurrent OpenAI image calls. Default 4 — enough for a 7-slide carousel
# in ~2 waves without tripping rate limits.
OPENAI_IMAGE_CONCURRENCY=4

# LLM that picks 0-2 reference images per generation (Single Image / Carousel /
# Email labs). One short JSON call per slide. Default: gpt-4.1-mini.
OPENAI_PICKER_MODEL=gpt-4.1-mini

# Google AI Studio API key (https://aistudio.google.com) — used by Veo
# (reel video gen), the email text generator, the reference classifier, and
# the shot-template derivation script. NOT used for image gen anymore.
GEMINI_API_KEY=

# Anthropic API key — used by /api/generate-caption to write IG/Carousel/Reel/X
# captions in the Space Ape voice. Mint at https://console.anthropic.com.
# Without this, the labs fall back to the legacy static caption pools.
ANTHROPIC_API_KEY=

# Optional override for the caption model. Default: claude-sonnet-4-6.
# Cheaper alternative: claude-haiku-4-5.
ANTHROPIC_CAPTION_MODEL=

# Model used by the one-shot classifier script (npm run classify-refs).
# Text-only Gemini call per ref image — cheap. Keep on flash tier.
GEMINI_VISION_MODEL=gemini-2.5-flash

# Port for the local API server (Vite proxies /api/* to this).
PORT=3001

# Veo video model (Reel Lounge). Default: Veo 3 Fast (~$0.40/sec output).
# Requires Veo 3 preview access on the API key. Fallback to "veo-2.0-generate-001"
# if your key does not have Veo 3 preview enabled.
VEO_VIDEO_MODEL=veo-3.0-fast-generate-preview

# Concurrent Veo jobs. Veo is heavy + expensive — default 1.
VEO_CONCURRENCY=1

# --- Instagram + Facebook Graph API (for the Post to Instagram button) ---
# Long-lived access token for an IG business/creator account linked to a
# Facebook Page. Generate in Meta Developer console → Graph API Explorer, then
# exchange for a 60-day long-lived token. Required scopes:
#   instagram_basic, instagram_content_publish, pages_read_engagement,
#   pages_show_list, pages_manage_posts, business_management
# (pages_manage_posts is required for the Facebook cross-post path — photos,
# multi-photo feed posts, and video_reels all need it.)
INSTAGRAM_ACCESS_TOKEN=

# Optional. If blank, the server auto-resolves it from /me/accounts on first
# call and caches for the process lifetime. Set explicitly to skip the lookup.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Optional. If blank, the server auto-resolves the first Page with an IG
# business account attached (the same Page IG already uses). Set explicitly
# if you have multiple Pages on the token and want to pick a specific one.
FACEBOOK_PAGE_ID=

# Optional. If blank, the server extracts a page-scoped token from
# /me/accounts using INSTAGRAM_ACCESS_TOKEN. Only set this if you minted a
# dedicated long-lived page token (e.g. via a System User).
FACEBOOK_PAGE_ACCESS_TOKEN=

# Public HTTPS origin that serves /generated/*.{png,mp4}. Instagram + Facebook
# fetch media from this URL, so localhost will NOT work — use your Railway
# domain (e.g. https://your-app.up.railway.app) or an ngrok tunnel during dev.
PUBLIC_BASE_URL=

# --- Threads (Meta's separate Threads Graph API at graph.threads.net) ---
# Long-lived (60-day) Threads access token. Mint via the Threads product in
# your existing Meta Developer App. Required scopes:
#   threads_basic, threads_content_publish
# Steps:
#   1. Add "Threads" product in Meta Developer console for the same App used by IG.
#   2. Threads OAuth playground / Graph Explorer → short-lived user token.
#   3. Exchange via:
#        GET https://graph.threads.net/access_token
#          ?grant_type=th_exchange_token
#          &client_secret=<APP_SECRET>
#          &access_token=<SHORT_LIVED_TOKEN>
#   4. Paste the resulting long-lived token here. The server's setInterval
#      refreshes it weekly (server/threadsRefresh.ts).
THREADS_ACCESS_TOKEN=

# Optional. If blank, the server resolves it from /me on first call and caches
# for the process lifetime.
THREADS_USER_ID=

# --- YouTube Shorts (YouTube Data API v3) ---
# Free tier: 10K quota units/day; one upload = 1600 units → ~6 uploads/day.
# Setup:
#   1. Enable "YouTube Data API v3" in Google Cloud Console (same project as Gemini/Veo).
#   2. Create OAuth 2.0 Client (Web app). Authorized redirect URI:
#        urn:ietf:wg:oauth:2.0:oob
#      (the out-of-band flow shows you an auth code to paste).
#   3. Paste the client id / secret below.
#   4. Run `tsx server/youtubeAuth.ts`, follow the prompts, paste the printed
#      refresh token as YOUTUBE_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Email send (Resend) ---
# Sign up at https://resend.com → API Keys → mint a key with "Sending access".
# IMPORTANT: to send to addresses other than the API key owner you must verify
# a sending domain in the Resend dashboard (DKIM/SPF DNS records). Without
# verification you'll get "you can only send testing emails to your own email
# address".
# QUICK START (no domain): set RESEND_FROM_EMAIL=onboarding@resend.dev — this
# is Resend's built-in test sender. It only delivers to the email you signed
# up with, but it works immediately with no DNS setup.
RESEND_API_KEY=

# Either onboarding@resend.dev (test mode, see above) OR an address on a
# domain you've verified in Resend (e.g. hello@spaceape.com).
RESEND_FROM_EMAIL=

# Optional. Display name shown in inboxes (e.g. "Space Ape").
RESEND_FROM_NAME=

# --- X / Twitter (X API v2 — requires Basic tier $200/mo for posting) ---
# Setup steps:
#   1. Create the @spaceape X account at x.com (or use existing).
#   2. Subscribe to X Basic at https://developer.x.com/en/portal/products
#   3. Create a Project + App in the developer portal.
#   4. Under "Keys and tokens" → User authentication settings:
#        Type: OAuth 2.0
#        App permissions: Read and write
#        Callback URI: urn:ietf:wg:oauth:2.0:oob
#        Website URL: https://content-engine-production-90c6.up.railway.app
#   5. Copy Client ID + Client Secret below.
#   6. Run `tsx server/xAuth.ts`, follow prompts, paste the printed
#      refresh token as X_REFRESH_TOKEN below (and into Railway).
# When all three are present the X checkbox in PostConfirmModal lights up;
# otherwise the row stays disabled with "X account not connected yet".
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
