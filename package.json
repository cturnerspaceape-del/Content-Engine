{
  "name": "content-engine-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "remotion:studio": "remotion studio remotion/index.tsx",
    "classify-refs": "tsx server/classifyReferences.ts",
    "ingest-refs": "tsx server/ingestReferences.ts",
    "derive-shots": "tsx server/deriveShotTemplates.ts",
    "sync-refs": "tsx scripts/syncRefs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@google/genai": "^1.30.0",
    "@remotion/google-fonts": "^4.0.447",
    "@remotion/player": "^4.0.447",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.447",
    "resend": "^6.12.2",
    "serve": "^14.2.6",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@remotion/cli": "^4.0.447",
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
